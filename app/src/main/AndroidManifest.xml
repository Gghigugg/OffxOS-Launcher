<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <application android:theme="@style/AppTheme" android:label="OffxOS Launcher" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".HomeSettingsActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".LockScreenActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".NotificationCenterActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".MusicPanelActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".AppDrawerActivity" android:screenOrientation="portrait" android:exported="false" />
        <service android:name=".OffxNotificationService" android:label="OffxOS Notifications" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
    </application>
</manifest>
